# Times Car Share (タイムズカーシェア) CLI credentials.
#
# Copy this file to .env and fill in your own values:
#
#     cp .env.example .env
#
# mise loads .env automatically (see [env] in mise.toml), so both
# `mise exec -- go run .` and `mise run run` see these variables. Nothing here
# is committed: .env is git-ignored.

# 会員番号（IC管理番号）— the 10-digit number on the member card, printed as
# "1234-567890". Hyphens and spaces are ignored.
TIMESCAR_MEMBER_NO=1234-567890

# パスワード — the password used to log in to share.timescar.jp.
TIMESCAR_PASSWORD=
